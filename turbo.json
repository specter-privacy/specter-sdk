{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:wasm"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig.json", "tsup.config.ts", "package.json"]
    },
    "build:wasm": {
      "outputs": ["src/wasm/web/**", "src/wasm/node/**"],
      "inputs": [
        "../../rust/specter-wasm/**",
        "../../vendor/specter-core/**",
        "../../vendor/specter-crypto/**"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build:wasm"],
      "outputs": ["coverage/**"]
    },
    "test:browser": {
      "dependsOn": [],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
